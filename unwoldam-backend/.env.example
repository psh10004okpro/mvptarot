# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/unwoldam_tarot
MONGODB_TEST_URI=mongodb://localhost:27017/unwoldam_tarot_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Daily Free Reading Limit
FREE_DAILY_READING_LIMIT=3
BASIC_DAILY_READING_LIMIT=10
PREMIUM_DAILY_READING_LIMIT=999

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Payment Gateway (예시 - 나중에 통합)
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# AI Services Configuration
# Claude API (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (for embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=tarot_interpretations

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Voice Services (CLOVA)
CLOVA_CLIENT_ID=your-clova-client-id
CLOVA_CLIENT_SECRET=your-clova-client-secret
CLOVA_TTS_URL=https://naveropenapi.apigw.ntruss.com/tts-premium/v1/tts
CLOVA_STT_URL=https://naveropenapi.apigw.ntruss.com/recog/v1/stt

# Voice Configuration
TTS_DEFAULT_SPEAKER=nara
TTS_CACHE_ENABLED=true
TTS_CACHE_EXPIRY=86400
AUDIO_MAX_DURATION=30

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_LENGTH=2000

# Logging
LOG_LEVEL=info
